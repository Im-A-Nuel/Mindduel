# Supply-chain hardening for the MiniPay listing.
#
# ignore-scripts: dependency lifecycle scripts (pre/post/install) do not run
#   automatically, so a compromised package cannot execute code on install.
#   Our own `npm run build` / `npm run dev` still run normally.
# minimum-release-age: reject any dependency version published less than 7 days
#   (10080 minutes) ago, so freshly published malicious releases — usually
#   yanked within days — cannot be installed. Honored by npm v11+.
# save-exact: new installs record exact versions, keeping package.json pinned.
ignore-scripts=true
minimum-release-age=10080
save-exact=true
